#!name=数字心动去广告修改版
#!desc=移除开屏广告、首页顶部标签、轮播图、悬浮挂件、热门搜索、信息流广告。
#!openUrl=https://apps.apple.com/app/id1532385111
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DigitalHeartbeat.png
#!date=2026-3-17

[Rewrite]
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-common-proxy-api\/api\/advertising\/proxy\/getOpenScreenAdvertising$/i then response.json.jq("if (getpath([\"data\"]) | has(\"advertisingList\")) then (setpath([\"data\",\"advertisingList\"]; [])) else . end")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/getBrand$/i then response.json.jq(".data |= map(select(.advertisementName == \"路跑赛事\" or .advertisementName == \"线上赛\" or .advertisementName == \"越野赛事\"))")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$/i then response.json.jq("delpaths([[\"data\",\"topHotSearchList\"]])")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$/i then response.json.jq("delpaths([[\"data\",\"bannerListTwo\"]])")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$/i then response.json.jq("delpaths([[\"data\",\"textAdvertisementList\"]])")
#^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$ response-body-json-jq '.data.recommendList |= map(select(.raceAdList | not or length == 0))'
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-race-proxy-api\/api\/home\/page\/get$/i then response.json.jq(".data.recommendList |= map(if has(\"raceAdList\") then .raceAdList = [] else . end)")
response if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-common-proxy-api\/api\/homePage\/proxy\/getSystemInfo$/i then response.json.jq("if (getpath([\"data\"]) | has(\"popAdvertisingList\")) then (setpath([\"data\",\"popAdvertisingList\"]; [])) else . end")

request if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-basic-center-api\/api\/appConfigBanner\/listBannerRelease\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-content-center-api\/api\/global\/search\/hotSearch\/list$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api-changzheng\.chinaath\.com\/changzheng-basic-center-api\/api\/advertisement\//i then reject_dict(200)

[MitM]
hostname=api-changzheng.chinaath.com